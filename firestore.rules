rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and zero-trust validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Reminders Subcollection
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      // User Reservations Subcollection
      match /reservations/{reservationId} {
        allow read, write: if isOwner(userId);
      }

      // User Prescriptions Subcollection
      match /prescriptions/{prescriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Verified Pharmacies (Public Directory Read, Admin Write)
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /inventory/{inventoryId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Public Medicine Reference Data
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
